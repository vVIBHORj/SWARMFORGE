# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/

# PyTorch checkpoints and model weights
*.pt
*.pth
*.bin
*.onnx
checkpoints/

# Run artifacts & telemetry (preserve .gitkeep)
runs/*
!runs/.gitkeep

# Node / Three.js
node_modules/
dist-viewer/
dist/
.vite/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Documents / local notes & scratch
*.tmp
*.log
*.docx
scratch/
project_spec.txt
