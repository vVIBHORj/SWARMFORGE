# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/

# PyTorch checkpoints and model weights (ignore transient checkpoints, allow production model)
*.pth
*.bin
*.onnx
checkpoints/
runs/mappo/latest.pt
runs/mappo/events.*

# Run artifacts & telemetry (track benchmark figures and production checkpoint)
runs/*
!runs/.gitkeep
!runs/benchmarks/
!runs/benchmarks/**
!runs/mappo/
runs/mappo/*
!runs/mappo/best.pt

# Node / Three.js
node_modules/
dist-viewer/
dist/
.vite/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Documents / local notes & scratch
*.tmp
*.log
*.docx
scratch/
project_spec.txt
